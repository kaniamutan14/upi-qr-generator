---
// QR Display Preview Card and Actions
---

<section class="qr-section" id="qrSection">
  <div class="qr-card">
    <div class="qr-container" id="qrContainer">
      <!-- Header (Top of QR) -->
      <div class="qr-header">
        <p class="qr-name-label" id="qrNameLabel"></p>
        <p class="qr-upi-label" id="qrUpiLabel"></p>
        <p class="qr-card-amount" id="qrCardAmount"></p>
        <p class="qr-card-note" id="qrCardNote"></p>
      </div>
      <div class="qr-divider"></div>

      <!-- QR Pattern -->
      <div class="qr-inner" id="qrInner"></div>

      <!-- Instructions (Bottom of QR) -->
      <div class="qr-divider"></div>
      <div class="qr-instructions">
        <p class="qr-inst-title">📲 Scan this QR code to pay</p>
        <p class="qr-inst-step"><span class="qr-step-num">1</span> Open any UPI app (GPay, PhonePe, Paytm)</p>
        <p class="qr-inst-step"><span class="qr-step-num">2</span> Tap <strong>Scan QR</strong> and scan this image</p>
        <div class="qr-subdivider"></div>
        <p class="qr-inst-wa">
          📱 <strong>Received on WhatsApp?</strong><br>
          Long press this image → Tap <strong>Share</strong> → Select your UPI app
        </p>
      </div>
    </div>
    <p class="qr-amount-text" id="qrAmountText"></p>
    <p class="qr-payee-text" id="qrPayeeText"></p>
  </div>

  <!-- Action Buttons -->
  <div class="btn-group">
    <button type="button" class="btn-whatsapp" id="whatsappBtn">
      <svg class="btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>Share on WhatsApp</span>
    </button>
    <button type="button" class="btn-download" id="downloadBtn">
      <svg class="btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span id="downloadBtnText">Download QR Image</span>
    </button>
  </div>
</section>
