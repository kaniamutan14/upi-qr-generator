---
import '../styles/styles.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "PayQR — Instant UPI QR Code Generator", 
  description = "Generate UPI payment QR codes instantly. Enter amount, generate QR, share via WhatsApp. No signup needed. Free and works offline." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  
  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <!-- PWA Meta -->
  <meta name="theme-color" content="#0a0a0f">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="PayQR">
  <link rel="icon" type="image/png" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <link rel="manifest" href="/manifest.webmanifest">
  
  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <ClientRouter />
</head>
<body>
  <div class="app-container">
    <slot />
  </div>

  <!-- Floating Studio Toast Notification -->
  <div id="payqrToast" class="payqr-toast hidden" role="alert">
    <span id="toastIcon">✓</span>
    <span id="toastMessage">Action completed successfully!</span>
  </div>

  <!-- Unified App Logic -->
  <script>
    import '../scripts/app.js';
  </script>
</body>
</html>
